# Railway MySQL credentials
MYSQLHOST=your-railway-mysql-host
MYSQLUSER=root
MYSQLPASSWORD=your-password
MYSQLDATABASE=railway
MYSQLPORT=3306

# MANDATORY SECURITY CONFIGURATION:
# JWT_SECRET is strictly required. The backend server will refuse to start and throw a fatal error if this is missing.
# Generate a cryptographically strong 256-bit secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=your-secure-jwt-secret-here

# TEST_SECRET is strictly required when running automated tests (NODE_ENV=test).
# Server refuses to start if NODE_ENV=test and TEST_SECRET is missing.
TEST_SECRET=your-test-secret-here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app
