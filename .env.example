# Frontend Environment Variables (Vite)
VITE_API_BASE=http://localhost:3000/api

# Backend Environment Variables (Node/Express Server)
PORT=5000

# MANDATORY SECURITY CONFIGURATION:
# JWT_SECRET is strictly required. The backend server will refuse to start and throw a fatal error if this is missing or unset.
# Generate a cryptographically strong 256-bit secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production

# TEST_SECRET is strictly required when running automated test suites (NODE_ENV=test) or when test reset is enabled (ENABLE_TEST_RESET=true).
# The server throws a fatal error and refuses to start if NODE_ENV=test and TEST_SECRET is unset.
# No fallback string is permitted in source code.
TEST_SECRET=replace_with_secure_test_secret_for_automated_testing

# Database Connection (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=kalpanaa_education_db
DB_PORT=3306

# Allowed Frontend Origins for CORS (comma-separated list for multiple origins)
FRONTEND_URL=http://localhost:3000
